#!/usr/bin/env bash
# Giả lập Antigravity CLI: như agy thật, KHÔNG in gì khi stdout không phải terminal
# (ateam phải chạy nó qua pty). In mã màu ANSI và \r để kiểm tra phần làm sạch output.
if [ "${@: -1}" = "--help" ]; then
  printf 'Usage: agy [OPTIONS]\n  --help\n  -p\n  --mode\n  --model\n  --effort\n  --print-timeout\n  --dangerously-skip-permissions\n  --output-format\n  --conversation\n'; exit 0
fi
if [ ! -t 1 ]; then exit 0; fi
if [ "${1:-}" = "models" ]; then
  printf '\033[1mAvailable models:\033[0m\r\n  gemini-3-pro      (default)\r\n  gemini-3-flash\r\n  claude-sonnet-5-5\r\n'
  exit 0
fi
source "$(dirname "$0")/_common.sh"
# như agy thật: model "thinking" không nhận --effort; model có effort trong tên thì xung đột
fm=""; fe=""; prev=""
for a in "$@"; do [ "$prev" = "--model" ] && fm="$a"; [ "$prev" = "--effort" ] && fe="$a"; prev="$a"; done
if [ -n "$fe" ] && [[ "$fm" == *-thinking ]]; then
  echo "error: invalid model selection (--model \"$fm\" --effort \"$fe\"): --effort is not supported for model \"$fm\""
  exit 1
fi
P="$fake_prompt"
if [[ "$P" == *"NEEDS_SHELL"* && " $* " != *" --dangerously-skip-permissions "* ]]; then
  # như agy thật khi bị từ chối quyền chạy lệnh ở chế độ headless: in lỗi rồi thoát 0
  echo 'jetski: no output produced — a tool required the "command" permission that headless mode cannot prompt for, so it was auto-denied.'
  exit 0
fi
if fake_overloaded agy; then  # nguyên văn agy thật (20/10/2026), thoát mã 3
  printf 'error: Our servers are experiencing high traffic right now, please try again in a minute. (UNAVAILABLE (code 503): No capacity available for model gemini-4-argon)\r\n'
  exit 3
fi
if [ "$P" = "/usage" ]; then
  printf 'Quota:\r\nGemini Models  Weekly Limit Remaining  29%%  2026-10-21 09:25 +07\r\n'
  exit 0
fi
body="$(if [[ "$P" == *"#1 by codex"* ]]; then echo "thấy kết quả task 1"; fi
echo "SUMMARY: đọc xong; ghi chú UTF-8 có trong prompt: $(echo "$P" | grep -c 'UTF-8')")"
fmt=""; conv=""; prev=""
for a in "$@"; do [ "$prev" = "--output-format" ] && fmt="$a"; [ "$prev" = "--conversation" ] && conv="$a"; prev="$a"; done
if [ "$fmt" = "stream-json" ]; then
  # như agy thật (1.4.4): id phiên ở sự kiện init; --conversation không còn -> cảnh báo, mở phiên MỚI, vẫn thoát 0.
  # Phiên đã có lưu ở thư mục ATEAM_FAKE_AGY_DIR (mặc định thư mục tạm) để lượt sau "nhớ" được
  store="${ATEAM_FAKE_AGY_DIR:-${TMPDIR:-/tmp}/ateam-fake-agy}"; mkdir -p "$store"
  if [ -n "$conv" ] && [ ! -f "$store/$conv" ]; then echo "warning: conversation \"$conv\" not found"; conv=""; fi
  if [ -n "$conv" ]; then body="nhớ phiên $conv
$body"; else conv="$(python3 -c 'import uuid; print(uuid.uuid4())')"; fi
  echo "$P" >> "$store/$conv"
  CONV="$conv" BODY="$body" python3 - <<'PY'
import json, os
cid, body = os.environ["CONV"], os.environ["BODY"]
def ev(kind, **kw):
    print(json.dumps(dict(event=kind, **kw), ensure_ascii=False), flush=True)
def step(**kw):
    ev("step_update", step_update=dict(conversation_id=cid, **kw))
ev("init", conversation_id=cid, init={"cwd": os.getcwd(), "tools": ["read_file"]})
step(step_index=0, state="DONE", step_type="user_input")
tool = {"name": "read_file", "parameters": {"Path": os.path.join(os.getcwd(), "README.md")}}
step(step_index=1, state="ACTIVE", step_type="tool", tool_name="read_file", tool_info=tool)
step(step_index=1, state="DONE", step_type="tool", tool_name="read_file", tool_info=tool, duration_seconds=0.01)
half = len(body) // 2  # chữ trả lời đến từng mẩu, cắt ngang dòng
step(step_index=2, state="ACTIVE", step_type="agent_response", text_delta=body[:half])
step(step_index=2, state="DONE", step_type="agent_response", text_delta=body[half:] + "\n")
ev("result", result={"conversation_id": cid, "status": "SUCCESS", "response": body + "\n", "num_turns": 1,
                     "usage": {"input_tokens": 1200, "output_tokens": 80, "thinking_tokens": 20,
                               "cache_read_tokens": 9000, "total_tokens": 1280}})
PY
  exit 0
fi
printf '\033[32mantigravity\033[0m đang đọc...\r\n'
printf 'loading 10%%\rloading 100%%\n'
echo "$body"
