#!/usr/bin/env bash
# Giả lập Claude Code (trưởng nhóm). Lấy prompt là đối số ngay sau -p.
fake_flags="-p --print --permission-mode --model --effort"
source "$(dirname "$0")/_common.sh"
P=""; prev=""; for a in "$@"; do [ "$prev" = "-p" ] && P="$a"; prev="$a"; done
if [ "$P" = "/usage" ]; then  # như claude -p /usage thật: không gọi model
  echo "Current session: 41% used · resets Oct 15 at 7:40pm"
  echo "Current week (all models): 26% used · resets Oct 20 at 6am"
  exit 0
fi
if fake_limited claude; then echo "Claude AI usage limit reached|$(( $(date +%s) + 3600 ))"; exit 1; fi
if [[ "$P" == *"you INTERVIEW the user"* ]]; then
  # /grill: hỏi 2 câu (đếm dòng "A<số>:" đã trả lời), rồi chốt đặc tả; người dùng dừng thì chốt ngay
  n=$(printf '%s\n' "$P" | grep -cE '^A[0-9]+:' || true)
  if [[ "$P" == *"wants to STOP the interview"* ]] || [ "$n" -ge 2 ]; then
    echo '{"done": true, "spec": "- Đăng nhập bằng email\n- Đã trả lời '"$n"' câu"}'
  else
    q=$((n + 1))
    echo '{"question": "Câu hỏi số '"$q"'?", "why": "để rõ phạm vi", "options": ["Phương án A", "Phương án B"], "recommended": "Phương án A"}'
  fi
elif [[ "$P" == *"git COMMIT MESSAGE"* ]]; then
  # Viết commit message (tab Git): trả lời sau SUMMARY:
  echo "Đang đọc diff..."
  echo "SUMMARY:"
  echo "Thêm file mới cho bản demo"
  echo ""
  echo "Ghi chú: viết bởi claude giả lập."
elif [[ "$P" == *"NEW FOLLOW-UP REQUEST"* ]]; then
  # Tiếp tục mục tiêu đã xong: 1 task bổ sung
  echo '[{"id":1,"agent":"codex","title":"Tạo d.txt","prompt":"tạo file d.txt","depends_on":[]}]'
elif [[ "$P" == *"Reply with ONLY a JSON array"* ]]; then
  # Lập kế hoạch: 3 task, task 3 phụ thuộc 1 và 2; effort "bogus" phải bị bỏ qua
  echo "Đang xem dự án..."
  cat <<'J'
```json
[{"id":1,"agent":"codex","title":"Tạo a.txt","prompt":"tạo file a.txt","depends_on":[],"effort":"xhigh"},
 {"id":2,"agent":"grok","title":"Tạo b.txt","prompt":"tạo file b.txt","depends_on":[]},
 {"id":3,"agent":"antigravity","title":"Tổng hợp","prompt":"đọc a và b","depends_on":[1,2],"effort":"bogus"}]
```
J
elif [[ "$P" == *"COMPACT it"* ]]; then
  # /compact: không đụng file, trả bản tóm tắt sau SUMMARY:
  echo "Đang đọc ghi chú..."
  echo "SUMMARY:"
  echo "- API chạy cổng 8080"
  echo "- Mục tiêu đã xong: tạo a, b, c"
elif [[ "$P" == *"Review round 1 of"* ]]; then
  echo '{"done": false, "summary": "Còn thiếu c.txt", "new_tasks": [{"id":1,"agent":"claude","title":"Tạo c.txt","prompt":"tạo c.txt","depends_on":[]}]}'
elif [[ "$P" == *"Review round"* ]]; then
  echo '{"done": true, "summary": "Đã đủ a, b, c.", "new_tasks": []}'
else
  for i in 1 2 3; do echo "claude bước $i"; fake_sleep; done
  echo c > c.txt
  echo "SUMMARY: đã tạo c.txt"
fi
