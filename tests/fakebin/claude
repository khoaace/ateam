#!/usr/bin/env bash
# Giả lập Claude Code (trưởng nhóm). Lấy prompt là đối số ngay sau -p.
fake_flags="-p --print --permission-mode --model --effort --session-id --resume"
source "$(dirname "$0")/_common.sh"
P=""; SID=""; RESUME=""; prev=""
for a in "$@"; do
  [ "$prev" = "-p" ] && P="$a"
  [ "$prev" = "--session-id" ] && SID="$a"
  [ "$prev" = "--resume" ] && RESUME="$a"
  prev="$a"
done
if [ "$P" = "/usage" ]; then  # như claude -p /usage thật: không gọi model
  echo "Current session: 41% used · resets Oct 15 at 7:40pm"
  echo "Current week (all models): 26% used · resets Oct 20 at 6am"
  exit 0
fi
if fake_limited claude; then echo "Claude AI usage limit reached|$(( $(date +%s) + 3600 ))"; exit 1; fi
# Như Claude Code thật: ghi file phiên ~/.claude/projects/<thư mục>/<phiên>.jsonl có usage (dashboard đọc);
# --session-id đặt tên phiên, --resume <id> nối tiếp phiên đó (không có file → lỗi như CLI thật)
if [ -n "${CLAUDE_CONFIG_DIR:-}" ] && command -v python3 >/dev/null; then
  python3 - "$P" "$PWD" "$SID" "$RESUME" <<'PY' || exit 1
import json, os, re, sys, time, uuid
p, cwd, sid, resume = sys.argv[1:5]
d = os.path.join(os.environ["CLAUDE_CONFIG_DIR"], "projects", re.sub(r"[^A-Za-z0-9]", "-", cwd))
os.makedirs(d, exist_ok=True)
ts = time.strftime("%Y-%m-%dT%H:%M:%S.000Z", time.gmtime())
mid = "msg_" + uuid.uuid4().hex
usage = {"input_tokens": 1000, "output_tokens": 200, "cache_read_input_tokens": 5000,
         "cache_creation_input_tokens": 300}
path = os.path.join(d, (resume or sid or uuid.uuid4().hex) + ".jsonl")
if resume and not os.path.exists(path):
    print(f"No conversation found with session ID: {resume}")
    sys.exit(1)
with open(path, "a") as f:
    f.write(json.dumps({"type": "user", "timestamp": ts, "message": {"role": "user", "content": p}}) + "\n")
    for _ in range(2):  # một tin nhắn, hai khối nội dung: cùng message.id → chỉ tính một lần
        f.write(json.dumps({"type": "assistant", "timestamp": ts,
                            "message": {"id": mid, "model": "claude-sonnet-4-6", "usage": usage}}) + "\n")
PY
fi
if [[ "$P" == *"you INTERVIEW the user"* ]]; then
  # /grill: hỏi 2 câu (đếm dòng "A<số>:" đã trả lời), rồi chốt đặc tả; người dùng dừng thì chốt ngay
  n=$(printf '%s\n' "$P" | grep -cE '^A[0-9]+:' || true)
  [[ "$P" == *"CHAM_HOI"* ]] && sleep 30  # trưởng nhóm nghĩ lâu: test bỏ /grill giữa chừng phải dừng được
  if [[ "$P" == *"wants to STOP the interview"* ]] || [ "$n" -ge 2 ]; then
    echo '{"done": true, "spec": "- Đăng nhập bằng email\n- Đã trả lời '"$n"' câu"}'
  else
    q=$((n + 1))
    echo '{"question": "Câu hỏi số '"$q"'?", "why": "để rõ phạm vi", "options": ["Phương án A", "Phương án B"], "recommended": "Phương án A"}'
  fi
elif [[ "$P" == *"WRITE THE PROJECT OVERVIEW"* ]]; then
  # /init: không đụng file, trả bản tổng quan giữa <<<OVERVIEW>>> … <<<END>>>; có bản cũ thì "cập nhật"
  [[ "$P" == *"TREO_INIT"* ]] && sleep 30  # khám phá lâu quá timeout
  echo "Đang đọc README..."
  echo "<<<OVERVIEW>>>"
  echo "- Purpose: dự án demo"
  echo "- Test: pytest -q"
  [[ "$P" == *"CURRENT OVERVIEW"* ]] && echo "- Updated: đã cập nhật"
  echo "<<<END>>>"
elif [[ "$P" == *"git COMMIT MESSAGE"* ]]; then
  # Viết commit message (tab Git): trả lời sau SUMMARY:
  echo "Đang đọc diff..."
  echo "SUMMARY:"
  echo "Thêm file mới cho bản demo"
  echo ""
  echo "Ghi chú: viết bởi claude giả lập."
elif [[ "$P" == *"INLINE CODE EDIT"* ]]; then
  # ⌘I tab Code: đoạn thay thế = đoạn đang chọn viết hoa, giữa <<<CODE>>> … <<<END>>> (không sửa file)
  [[ "$P" == *"CHAM_SUA"* ]] && sleep 2  # sửa lâu: test tab vẫn dùng được trong lúc chờ
  sel=$(printf '%s\n' "$P" | awk '/^<<<SELECTION>>>$/{f=1;next} f&&/^<<<END>>>$/{exit} f')
  echo "Đang sửa đoạn code..."
  echo "<<<CODE>>>"
  printf '%s\n' "$sel" | tr '[:lower:]' '[:upper:]'
  echo "<<<END>>>"
elif [[ "$P" == *"EXPLAIN CODE"* ]]; then
  echo "Đang đọc code..."
  echo "SUMMARY:"
  echo "**Đoạn này** trả về lời chào."
  echo ""
  echo "- dùng \`hello(name)\`"
elif [[ "$P" == *"WRITE AN AGENT SKILL"* ]]; then
  # ✨ viết skill (theo mô tả / rút từ mục tiêu đã xong): SKILL.md giữa <<<SKILL>>> … <<<END>>>, bọc rào markdown
  name="phat-hanh"; [[ "$P" == *"captures how the team completed"* ]] && name="tu-muc-tieu"
  echo "Đang viết skill..."
  printf '<<<SKILL>>>\n```markdown\n---\nname: %s\ndescription: "Release a new version. Use when the user asks to publish."\n---\n\n# Release\n1. Bump the version\n2. Push\n```\n<<<END>>>\n' "$name"
elif [[ "$P" == *"reusable ateam WORKFLOW"* ]]; then
  # Gợi ý workflow tuỳ chỉnh: agent lạ (ghost) và effort lạ để test chuẩn hoá
  sleep 0.5  # chậm như model thật: test không được đọc form trước khi gợi ý về
  echo '{"name": "Tính năng UI", "description": "Thiết kế → code → kiểm tra giao diện", "review": false, "steps": [
    {"agent": "lead", "title": "Thiết kế {goal}", "prompt": "Viết thiết kế ngắn cho {goal}", "after": []},
    {"agent": "codex", "title": "Viết code", "prompt": "Làm {goal} theo thiết kế", "effort": "rất cao"},
    {"agent": "ghost", "title": "Kiểm tra", "prompt": "Chạy test cho {goal}", "after": [1, 9]}]}'
elif [[ "$P" == *"NEW FOLLOW-UP REQUEST"* ]]; then
  # Tiếp tục mục tiêu đã xong: 1 task bổ sung
  echo '[{"id":1,"agent":"codex","title":"Tạo d.txt","prompt":"tạo file d.txt","depends_on":[]}]'
elif [[ "$P" == *"To ask the user first"* && "$P" == *"CAN_HOI"* ]]; then
  # Lập kế hoạch mà mục tiêu chưa rõ: hỏi lại người dùng trước (như /grill)
  echo '{"question": "Đăng nhập bằng gì?", "why": "đổi cách làm", "options": ["Email", "Google"], "recommended": "Email"}'
elif [[ "$P" == *"Reply with ONLY a JSON array"* && "$P" == *"CO_KIEMTRA"* ]]; then
  # Kế hoạch có loại task: 2 task code song song + 1 review (ateam tự thêm kiểm tra cuối khi có lệnh /verify)
  echo '[{"id":1,"type":"code","agent":"codex","title":"Tạo a.txt","prompt":"tạo file a.txt","depends_on":[]},
 {"id":2,"type":"code","agent":"grok","title":"Tạo b.txt","prompt":"tạo file b.txt","depends_on":[]},
 {"id":3,"type":"review","agent":"claude","title":"Review","prompt":"xem lại a và b","depends_on":[1,2]}]'
elif [[ "$P" == *"Reply with ONLY a JSON array"* && -n "${ATEAM_FAKE_PLAN_SKILLS:-}" && "$P" == *"AVAILABLE SKILLS"* ]]; then
  # Skill: trưởng nhóm gắn skill (một tên không có trong danh mục — ateam phải bỏ) vào task code, review không gắn
  echo "[{\"id\":1,\"agent\":\"codex\",\"title\":\"Tạo a.txt\",\"prompt\":\"tạo file a.txt\",\"depends_on\":[],\"skills\":[\"$ATEAM_FAKE_PLAN_SKILLS\",\"khong-co\"]},
 {\"id\":2,\"type\":\"review\",\"agent\":\"claude\",\"title\":\"Review\",\"prompt\":\"xem lại a\",\"depends_on\":[1]}]"
elif [[ "$P" == *"Reply with ONLY a JSON array"* && "$P" == *"TREO_LAP"* ]]; then
  # CLI treo khi lập kế hoạch (như agy không in gì): test huỷ / lead_timeout
  sleep 30
elif [[ "$P" == *"Reply with ONLY a JSON array"* ]]; then
  # Lập kế hoạch: 3 task, task 3 phụ thuộc 1 và 2; effort "bogus" phải bị bỏ qua
  echo "Đang xem dự án..."
  cat <<'J'
```json
[{"id":1,"agent":"codex","title":"Tạo a.txt","prompt":"tạo file a.txt","depends_on":[],"effort":"xhigh"},
 {"id":2,"agent":"grok","title":"Tạo b.txt","prompt":"tạo file b.txt","depends_on":[]},
 {"id":3,"agent":"antigravity","title":"Tổng hợp","prompt":"đọc a và b","depends_on":[1,2],"effort":"bogus"}]
```
J
elif [[ "$P" == *"COMPACT it"* ]]; then
  # /compact: không đụng file, trả bản tóm tắt sau SUMMARY:
  echo "Đang đọc ghi chú..."
  echo "SUMMARY:"
  echo "- API chạy cổng 8080"
  echo "- Mục tiêu đã xong: tạo a, b, c"
elif [[ "$P" == *"Review round 1 of"* ]]; then
  echo '{"done": false, "summary": "Còn thiếu c.txt", "new_tasks": [{"id":1,"agent":"claude","title":"Tạo c.txt","prompt":"tạo c.txt","depends_on":[]}]}'
elif [[ "$P" == *"Review round"* ]]; then
  echo '{"done": true, "summary": "Đã đủ a, b, c.", "new_tasks": []}'
elif [[ "$P" == *"You REVIEW"* ]]; then
  # Task review: xem diff, không sửa gì; CO_LOI → giao sửa cho tác giả (codex) bằng DELEGATE
  echo "Đang xem diff..."
  if [[ "$P" == *"CO_LOI"* ]]; then
    printf '<<<DELEGATE to="codex" title="Sửa lỗi review">>>\nsửa lỗi ở a.txt dòng 1\n<<<END>>>\n'
    echo "SUMMARY: còn lỗi a.txt:1 — đã giao codex sửa"
  else
    echo "SUMMARY: no issues found"
  fi
elif [[ "$P" == *"ASKME"* && "$P" != *"YOU ASKED THE USER EARLIER"* ]] && [ -z "$RESUME" ]; then
  # <<<ASK>>>: hỏi người dùng giữa task (lượt đầu, chưa có câu trả lời)
  echo wip > wip.txt
  echo '<<<ASK>>>{"question": "Dùng SQLite hay Postgres?", "why": "đổi cách lưu", "options": ["SQLite", "Postgres"], "recommended": "SQLite"}<<<END>>>'
else
  [ -n "$RESUME" ] && echo "claude: tiếp tục phiên $RESUME"
  [[ "$P" == *"A: "* ]] && echo "claude: câu trả lời ${P##*A: }" | head -1
  for i in 1 2 3; do echo "claude bước $i"; fake_sleep; done
  echo c > c.txt
  echo "SUMMARY: đã tạo c.txt"
fi
