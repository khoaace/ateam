#!/usr/bin/env bash
# Giả lập Codex: tạo a.txt, giao README cho grok, để lại ghi chú; biết sửa lỗi test
# (tạo fixed.txt) và biết làm trưởng nhóm dự phòng.
if [ "${@: -1}" = "--help" ]; then
  opts="--sandbox --skip-git-repo-check -m --model -c --config --image"
  if [ "${1:-}" = "exec" ] && [ "${2:-}" = "resume" ]; then opts="--skip-git-repo-check -m --model -c --config --image"; fi
  if [ "${1:-}" = "debug" ]; then opts="--bundled -c --config"; fi
  printf 'Usage: codex [OPTIONS]\n  --help\n'
  for option in $opts; do printf '  %s\n' "$option"; done
  exit 0
fi
fake_flags="--sandbox --skip-git-repo-check -m --model -c --config"
source "$(dirname "$0")/_common.sh"
# `codex exec resume [OPTIONS] <SESSION_ID> <PROMPT>`: không nhận --sandbox; phiên lạ → lỗi
RESUME=""
if [ "${1:-}" = "exec" ] && [ "${2:-}" = "resume" ]; then
  for a in "$@"; do
    if [ "$a" = "--sandbox" ]; then printf "error: unexpected argument '--sandbox' found\n" >&2; exit 2; fi
  done
  RESUME="${@: -2:1}"
  if [ -n "${CODEX_HOME:-}" ] && [ ! -f "$CODEX_HOME/fake_sessions/$RESUME" ]; then
    echo "Error: thread $RESUME not found"; exit 1
  fi
fi
# Như codex >= 0.152: --full-auto đã bị bỏ
for a in "$@"; do
  if [ "$a" = "--full-auto" ]; then
    printf "error: unexpected argument '--full-auto' found\n\nUsage: codex exec [OPTIONS] [PROMPT]\n" >&2; exit 2
  fi
done
if [ "${1:-}" = "debug" ] && [ "${2:-}" = "models" ]; then  # như codex thật: JSON trên 1 dòng
  # như codex thật: mỗi model kèm supported_reasoning_levels và chữ dài (bản thật ~500KB) — ateam không được cắt dòng
  pad=$(python3 -c 'print("x" * 150000)')
  L='[{"effort":"low"},{"effort":"medium"},{"effort":"high"},{"effort":"xhigh"},{"effort":"max"}'
  echo '{"models":[{"slug":"gpt-6.1-sol","visibility":"list","supported_reasoning_levels":'"$L"',{"effort":"ultra"}],"model_messages":{"persistent_instructions":"'"$pad"'"}},{"slug":"gpt-reserve","visibility":"hide"},{"slug":"gpt-6-luna","visibility":"list","supported_reasoning_levels":'"$L"']},{"slug":"codex-auto-review","visibility":"hide"}]}'
  exit 0
fi
P="$fake_prompt"
if fake_limited codex; then echo "ERROR: You've hit your usage limit. Try again in 7 minutes."; exit 1; fi
# header như `codex exec` thật
SID="${RESUME:-$(python3 -c 'import uuid; print(uuid.uuid4())')}"
echo "session id: $SID"
if [ -n "${CODEX_HOME:-}" ]; then mkdir -p "$CODEX_HOME/fake_sessions"; touch "$CODEX_HOME/fake_sessions/$SID"; fi
[ -n "$RESUME" ] && echo "codex: tiếp tục phiên $RESUME"
# như codex thật: in lại cả prompt ("user\n<prompt>") trước câu trả lời — có JSON mẫu, khối DELEGATE/NOTE/ASK ví dụ
printf -- '--------\nuser\n%s\ncodex\n' "$P"
if [[ "$P" == *"git COMMIT MESSAGE"* ]]; then printf 'SUMMARY:\nCodex viết message này\n'; exit 0; fi
if [[ "$P" == *"TEAM LEAD"* && "$P" == *"Reply with ONLY a JSON array"* ]]; then
  plan='[{"id":1,"agent":"grok","title":"Kế hoạch do codex lập","prompt":"tạo file b.txt","depends_on":[]}]'
  # model quên dấu ] cuối mảng (gặp thật với gpt-6.1-sol); codex in câu trả lời 2 lần: trong luồng và ra stdout
  if [[ "$P" == *"THIEU_NGOAC"* ]]; then plan="${plan%]}"; printf '%s\ntokens used\n24,916\n' "$plan"; fi
  echo "$plan"; exit 0
fi
if [[ "$P" == *"TEAM LEAD"* ]]; then echo '{"done": true, "summary": "codex review: ok", "new_tasks": []}'; exit 0; fi
if [[ "$P" == *"VERIFICATION COMMAND"* ]]; then echo "codex: sửa lỗi test"; touch fixed.txt; echo "SUMMARY: thêm fixed.txt"; exit 0; fi
if [[ "$P" == *"NEW REQUEST:"* && "$P" == *"Your result:"* ]]; then echo "codex: nhớ lượt trước"; fi
for i in 1 2 3; do echo "codex bước $i"; fake_sleep; done
if [[ "$P" == *"README"* ]]; then echo readme > README.md; echo "SUMMARY: viết README"; exit 0; fi
echo a > a.txt
if [[ "$P" == *"DELEGATE"* ]]; then
cat <<'D'
<<<DELEGATE to="grok" title="Viết README cho a">>>
Viết README.md mô tả a.txt
<<<END>>>
D
fi
echo "<<<NOTE>>>a.txt dùng UTF-8<<<END>>>"
echo "SUMMARY: tạo a.txt"
