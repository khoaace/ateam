#!/usr/bin/env bash
# Giả lập OpenCode chạy Grok: tạo b.txt, hoặc README.md nếu được giao viết README.
oc_version="${ATEAM_FAKE_OPENCODE_VERSION:-1.19.3}"
oc_major="${oc_version%%.*}"
if [ -n "${ATEAM_FAKE_OPENCODE_LOG:-}" ]; then printf '%s\n' "$*" >> "$ATEAM_FAKE_OPENCODE_LOG"; fi
if [ "${1:-}" = "--version" ]; then
  if [ "$oc_version" = "fail" ]; then exit 1; fi
  echo "opencode v$oc_version"; exit 0
fi
if [ "${@: -1}" = "--help" ]; then
  case "${1:-}" in
    models) opts="--standalone --server"; [ "$oc_major" != "2" ] && opts="$opts --verbose" ;;
    api) opts="--standalone --server --param --data --header" ;;
    stats) opts="--standalone --server --days --json --models --project" ;;
    *) opts="--model --auto --file -f --session --continue"; [ "$oc_major" != "2" ] && opts="$opts --variant" ;;
  esac
  printf 'Usage: opencode [OPTIONS]\n  --help\n'
  for option in $opts; do printf '  %s\n' "$option"; done
  exit 0
fi
if [ "${1:-}" = "api" ]; then
  if [ "$oc_major" != "2" ] || [ "${2:-}" != "model.list" ]; then exit 1; fi
  if [ "${4:-}" != "location[directory]=$PWD" ]; then echo '{"error":"wrong location"}'; exit 1; fi
  case "${ATEAM_FAKE_OPENCODE_CATALOG:-ok}" in
    error) echo '{"error":"metadata unavailable","settings":"FAKE_CATALOG_SECRET"}'; exit 1 ;;
    invalid) echo '{"invalid":'; exit 0 ;;
    empty) echo '{"location":{},"data":[]}'; exit 0 ;;
    timeout) sleep 5; exit 1 ;;
  esac
  cat <<'JSON'
{"location":{},"data":[
  {"providerID":"openai","id":"gpt-5.5","enabled":true,"variants":[{"id":"low"},{"id":"medium"},{"id":"high"},{"id":"xhigh"}]},
  {"providerID":"xai","id":"grok-build-0.1","enabled":true,"variants":[],"settings":{"apiKey":"FAKE_CATALOG_SECRET"}},
  {"providerID":"xai","id":"grok-4.7","enabled":true,"variants":[{"id":"low"},{"id":"medium"},{"id":"high"},{"id":"xhigh"}]},
  {"providerID":"xai","id":"grok-5-fast","enabled":true,"variants":[]},
  {"providerID":"anthropic","id":"claude-sonnet-5-5","enabled":true,"variants":[{"id":"low"},{"id":"medium"},{"id":"high"},{"id":"xhigh"},{"id":"max"}]},
  {"providerID":"opencode","id":"deepseek-v4.1-flash-free","enabled":true,"variants":[{"id":"low"},{"id":"high"},{"id":"max"}]}
]}
JSON
  exit 0
fi
if [ "${1:-}" = "models" ] && [ "${2:-}" = "--verbose" ]; then  # như opencode 1.19: tên rồi object JSON nhiều dòng
  if [ "$oc_major" = "2" ]; then echo 'ERROR: Unrecognized flag: --verbose'; exit 1; fi
  for m in "openai/gpt-5.5:low medium high xhigh" "xai/grok-build-0.1:" "xai/grok-4.7:low medium high xhigh" \
           "xai/grok-5-fast:" "anthropic/claude-sonnet-5-5:low medium high xhigh max" \
           "opencode/deepseek-v4.1-flash-free:low high max"; do
    printf '%s\n{\n  "id": "%s",\n  "variants": {' "${m%%:*}" "${m%%:*}"
    sep=""; for v in ${m#*:}; do printf '%s\n    "%s": {\n      "reasoningEffort": "%s"\n    }' "$sep" "$v" "$v"; sep=","; done
    printf '\n  }\n}\n'
  done
  exit 0
fi
if [ "${1:-}" = "models" ]; then
  if [ "${ATEAM_FAKE_OPENCODE_MODELS_FAIL:-0}" = "1" ]; then echo 'ERROR: models unavailable'; exit 1; fi
  printf 'openai/gpt-5.5\nxai/grok-build-0.1\nxai/grok-4.7\nxai/grok-5-fast\nanthropic/claude-sonnet-5-5\nopencode/deepseek-v4.1-flash-free\n'
  exit 0
fi
if [ "${1:-}" = "stats" ]; then
  for i in $(seq 1 30); do echo "│stat dòng $i │"; done  # dài như bảng thật -> ateam chỉ giữ 20 dòng
  exit 0
fi
fake_flags="--model --variant --auto"
if [ "$oc_major" = "2" ]; then fake_flags="--model --auto"; fi
if [ "${1:-}" = "run" ]; then
  model_next=0
  for a in "$@"; do
    if [ "$oc_major" = "2" ] && [ "$a" = "--variant" ]; then echo 'ERROR: Unrecognized flag: --variant'; exit 1; fi
    if [ "$oc_major" = "1" ] && [ "$model_next" = "1" ] && [[ "$a" == *#* ]]; then echo 'ERROR: Unexpected server error'; exit 1; fi
    model_next=0
    if [ "$a" = "--model" ] || [ "$a" = "-m" ]; then model_next=1; fi
  done
fi
source "$(dirname "$0")/_common.sh"
P="$fake_prompt"
# như opencode thật: -f/--file là mảng yargs, nuốt mọi đối số đứng sau cho tới cờ kế tiếp hoặc "--"
eating=0
for a in "$@"; do
  case "$a" in
    --) break ;;
    -f|--file) eating=1 ;;
    --file=*) eating=1 ;;
    -*) eating=0 ;;
    *) if [ "$eating" = 1 ] && [ "$a" = "$P" ]; then echo "Error: File not found: $P"; exit 1; fi ;;
  esac
done
if fake_limited grok; then echo "Error: 429 Too Many Requests — rate limit exceeded"; exit 1; fi
for i in 1 2; do echo "opencode bước $i"; fake_sleep; done
# ATEAM_FAKE_OPENCODE_RC: như opencode 2.0 khi Web Search bị huỷ giữa phiên — in đủ câu trả lời rồi thoát mã khác 0
oc_rc="${ATEAM_FAKE_OPENCODE_RC:-0}"
if [ "$oc_rc" != 0 ]; then echo '✗ Web Search "x" failed'; echo 'Error: Web search cancelled'; fi
if [ "${ATEAM_FAKE_OPENCODE_NO_SUMMARY:-0}" = 1 ]; then echo "dừng giữa chừng"; exit "$oc_rc"; fi
if [[ "$P" == *"README"* ]]; then echo readme > README.md; echo "SUMMARY: viết README"; exit 0; fi
echo b > b.txt
echo "SUMMARY: tạo b.txt"
exit "$oc_rc"
