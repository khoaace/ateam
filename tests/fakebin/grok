#!/usr/bin/env bash
# Giả lập Grok Build CLI: `grok -p "<prompt>"` in kết quả rồi thoát; `grok models` liệt kê model.
if [ "${1:-}" = "models" ]; then  # như grok thật (kể cả dòng thừa trước danh sách)
  printf 'Default model: grok-4.7\n\nAvailable models:\n  * grok-4.7 (default)\n  - grok-4.7-build-fast\n  - grok-4.6\n'
  exit 0
fi
fake_flags="-p --single -m --model --reasoning-effort --effort --permission-mode"
source "$(dirname "$0")/_common.sh"
P=""; prev=""; for a in "$@"; do [ "$prev" = "-p" ] && P="$a"; prev="$a"; done
if fake_limited grok; then echo "Error: 429 Too Many Requests — rate limit exceeded"; exit 1; fi
for i in 1 2; do echo "grok bước $i"; fake_sleep; done
if [[ "$P" == *"README"* ]]; then echo readme > README.md; echo "SUMMARY: viết README"; exit 0; fi
echo b > b.txt
echo "SUMMARY: tạo b.txt"
