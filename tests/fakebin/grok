#!/usr/bin/env bash
# Giả lập Grok Build CLI: `grok -p "<prompt>"` in kết quả rồi thoát; `grok models` liệt kê model.
if [ "${@: -1}" = "--help" ] && [ "${1:-}" = "models" ]; then
  printf 'Usage: grok models [OPTIONS]\n  --help\n'; exit 0
fi
if [ "${1:-}" = "usage" ]; then  # như `grok usage <phiên>` thật: JSON token & cost đã lưu (costUsdTicks = 10^10/USD)
  now=$(date -u +%Y-%m-%dT%H:%M:%S+00:00)
  printf '{"sessionId": "%s", "session": {"totalTokens": 150000, "costUsdTicks": 30000000000}, "turns": [
    {"turnNumber": 1, "endedAt": "%s", "totalTokens": 100000, "costUsdTicks": 20000000000},
    {"turnNumber": 2, "endedAt": "2020-01-01T00:00:00+00:00", "totalTokens": 50000, "costUsdTicks": 10000000000}]}\n' "$2" "$now"
  exit 0
fi
if [ "${1:-}" = "models" ]; then  # như grok thật (kể cả dòng thừa trước danh sách)
  if [ "${ATEAM_FAKE_GROK_UNAUTHENTICATED:-0}" = "1" ]; then echo 'You are not authenticated.'; fi
  if [ "${ATEAM_FAKE_GROK_AUTH_ONLY:-0}" = "1" ]; then echo 'You are not authenticated.'; exit 0; fi
  printf 'Default model: grok-4.7\n\nAvailable models:\n  * grok-4.7 (default)\n  - grok-4.7-build-fast\n  - grok-4.6\n'
  exit 0
fi
fake_flags="-p --single -m --model --reasoning-effort --effort --permission-mode --deny --allow --session-id --resume"
source "$(dirname "$0")/_common.sh"
P=""; prev=""; for a in "$@"; do [ "$prev" = "-p" ] && P="$a"; prev="$a"; done
if [[ "$P" == *"NEEDS_SHELL"* && " $* " == *" --deny Bash "* ]]; then
  # như grok thật khi --deny Bash chặn lệnh shell: model kể lại, thoát 0
  echo "I'll run the lint command.\`npm run lint\` did not run. The shell is blocked in this session by a permission policy that denies bash."
  exit 0
fi
if fake_limited grok; then echo "Error: 429 Too Many Requests — rate limit exceeded"; exit 1; fi
for i in 1 2; do echo "grok bước $i"; fake_sleep; done
if [[ "$P" == *"README"* ]]; then echo readme > README.md; echo "SUMMARY: viết README"; exit 0; fi
echo b > b.txt
echo "SUMMARY: tạo b.txt"
